  "scenes": [
    { "id": "hook", "pre": 0.25, "post": 0.3, "lines": [
      { "id": "h1", "who": "narrator", "text": "Тебе в наследство достался маяк.", "gap": 0.25,
        "parts": [["Тебе в наследство достался маяк.", -4, -2]] },
      { "id": "h2", "who": "narrator", "text": "И долг. Миллион восемьсот тысяч.", "gap": 0.25,
        "parts": [["И долг.", -10, -6, 0.38], ["Миллион восемьсот тысяч.", -4, -3]] },
      { "id": "h3", "who": "narrator", "text": "Через тридцать дней маяк заберёт банк.", "gap": 0.3,
        "parts": [["Через тридцать дней маяк заберёт банк.", 0, -1]] },
      { "id": "h4", "who": "narrator", "text": "А сегодня ночью на нём загорится свет. Хотя его отключили пятнадцать лет назад.", "gap": 0.0,
        "parts": [["А сегодня ночью на нём загорится свет.", -6, -2, 0.42], ["Хотя его отключили пятнадцать лет назад.", -8, -5]] }
    ]},
    { "id": "rules", "pre": 0.2, "post": 0.3, "lines": [
      { "id": "r1", "who": "narrator", "text": "Это сериал, в котором решаешь ты.", "gap": 0.25,
        "parts": [["Это сериал, в котором решаешь ты.", 4, 3]] },
      { "id": "r2", "who": "narrator", "text": "Какой вариант победит в комментариях — так и будет.", "gap": 0.0,
        "parts": [["Какой вариант победит в комментариях — так и будет.", 4, 2]] }
    ]},
    { "id": "title", "pre": 0.3, "post": 0.35, "lines": [
      { "id": "t1", "who": "narrator", "text": "Смотритель. Серия первая.", "gap": 0.0,
        "parts": [["Смотритель.", -10, -5, 0.4], ["Серия первая.", -4, -2]] }
    ]},
    { "id": "city", "pre": 0.3, "post": 0.3, "lines": [
      { "id": "c1", "who": "narrator", "text": "Тебе двадцать шесть. Вчера тебя сократили.", "gap": 0.28,
        "parts": [["Тебе двадцать шесть.", 0, 0, 0.3], ["Вчера тебя сократили.", -6, -5]] },
      { "id": "c2", "who": "narrator", "text": "На карте — сорок одна тысяча. За комнату платить через неделю.", "gap": 0.6,
        "parts": [["На карте — сорок одна тысяча.", 0, -1, 0.3], ["За комнату платить через неделю.", -3, -3]] },
      { "id": "c3", "who": "narrator", "text": "И тут звонит незнакомый номер.", "gap": 0.3,
        "parts": [["И тут звонит незнакомый номер.", 6, 3]] },
      { "id": "c4", "who": "notary", "text": "Вы внук Захара Ильича? Примите соболезнования. Он оставил вам маяк.", "gap": 0.28,
        "parts": [["Вы внук Захара Ильича?", 0, 2, 0.35], ["Примите соболезнования.", -6, -3, 0.4], ["Он оставил вам маяк.", -4, 0]] },
      { "id": "c5", "who": "narrator", "text": "Деда ты почти не знал. Но выбирать не из чего.", "gap": 0.0,
        "parts": [["Деда ты почти не знал.", 0, 0, 0.3], ["Но выбирать не из чего.", -6, -4]] }
    ]},
    { "id": "road", "pre": 0.3, "post": 0.3, "lines": [
      { "id": "v1", "who": "narrator", "text": "Четырнадцать часов на автобусе.", "gap": 0.28,
        "parts": [["Четырнадцать часов на автобусе.", 2, 0]] },
      { "id": "v2", "who": "narrator", "text": "Конечная — посёлок Сизый Мыс. Дальше только море.", "gap": 0.0,
        "parts": [["Конечная — посёлок Сизый Мыс.", 0, 0, 0.32], ["Дальше только море.", -8, -3]] }
    ]},
    { "id": "arrival", "pre": 0.6, "post": 0.35, "lines": [
      { "id": "a1", "who": "narrator", "text": "Вот он. Тридцать два метра.", "gap": 0.28,
        "parts": [["Вот он.", -12, -3, 0.45], ["Тридцать два метра.", -2, 1]] },
      { "id": "a2", "who": "narrator", "text": "Отключён в две тысячи девятом.", "gap": 0.3,
        "parts": [["Отключён в две тысячи девятом.", -3, -3]] },
      { "id": "a3", "who": "narrator", "text": "Теперь — твой.", "gap": 0.0,
        "parts": [["Теперь — твой.", -10, 2]] }
    ]},
    { "id": "notary", "pre": 0.35, "post": 0.35, "lines": [
      { "id": "n1", "who": "narrator", "text": "Нотариус отдаёт ключи. И ещё одну бумагу.", "gap": 0.26,
        "parts": [["Нотариус отдаёт ключи.", 2, 1, 0.35], ["И ещё одну бумагу.", -8, -5]] },
      { "id": "n2", "who": "narrator", "text": "За три месяца до смерти дед взял кредит. Миллион восемьсот. Под залог маяка.", "gap": 0.26,
        "parts": [["За три месяца до смерти дед взял кредит.", 0, -1, 0.32], ["Миллион восемьсот.", -8, -4, 0.3], ["Под залог маяка.", -5, -4]] },
      { "id": "n3", "who": "narrator", "text": "Куда ушли деньги — не знает никто.", "gap": 0.26,
        "parts": [["Куда ушли деньги — не знает никто.", -4, -2]] },
      { "id": "n4", "who": "narrator", "text": "Тридцать дней — или маяк уходит банку.", "gap": 0.0,
        "parts": [["Тридцать дней — или маяк уходит банку.", -2, -4]] }
    ]},
    { "id": "lyadov", "pre": 0.4, "post": 0.35, "lines": [
      { "id": "d1", "who": "narrator", "text": "К дому подъезжает белый джип.", "gap": 0.25,
        "parts": [["К дому подъезжает белый джип.", 5, 2]] },
      { "id": "d2", "who": "narrator", "text": "Глеб Лядов. Строит на берегу отель. Улыбается тебе, как старому другу.", "gap": 0.26,
        "parts": [["Глеб Лядов.", -6, -3, 0.3], ["Строит на берегу отель.", 2, 0, 0.3], ["Улыбается тебе, как старому другу.", -2, 2]] },
      { "id": "d3", "who": "lyadov", "text": "Соболезную. Я закрываю твой долг и даю пятьсот тысяч сверху. А маяк — мне.", "gap": 0.3,
        "parts": [["Соболезную.", -8, -2, 0.38], ["Я закрываю твой долг и даю пятьсот тысяч сверху.", 0, 0, 0.38], ["А маяк — мне.", -10, -4]] },
      { "id": "d4", "who": "narrator", "text": "Столько ты зарабатывал за год.", "gap": 0.28,
        "parts": [["Столько ты зарабатывал за год.", -3, -2]] },
      { "id": "d5", "who": "lyadov", "text": "Думай до утра. В девять привезу договор.", "gap": 0.35,
        "parts": [["Думай до утра.", -4, 0, 0.35], ["В девять привезу договор.", 0, -3]] },
      { "id": "d6", "who": "narrator", "text": "Странно одно. Зачем отелю ржавый маяк, который не светит?", "gap": 0.0,
        "parts": [["Странно одно.", -8, -3, 0.4], ["Зачем отелю ржавый маяк, который не светит?", 0, 2]] }
    ]},
    { "id": "nyura", "pre": 0.35, "post": 0.4, "lines": [
      { "id": "b1", "who": "narrator", "text": "Вечером заходит соседка, баба Нюра. И говорит тихо:", "gap": 0.3,
        "parts": [["Вечером заходит соседка, баба Нюра.", 2, 1, 0.32], ["И говорит тихо:", -10, -5]] },
      { "id": "b2", "who": "nyura", "text": "Захар не продал. И ты не продавай. Он там что-то прятал.", "gap": 0.0,
        "parts": [["Захар не продал.", -4, 0, 0.4], ["И ты не продавай.", -6, 2, 0.45], ["Он там что-то прятал.", -12, -4]] }
    ]},
    { "id": "journal", "pre": 0.35, "post": 0.4, "lines": [
      { "id": "j1", "who": "narrator", "text": "На столе в доме смотрителя — вахтенный журнал деда.", "gap": 0.28,
        "parts": [["На столе в доме смотрителя — вахтенный журнал деда.", -3, -2]] },
      { "id": "j2", "who": "narrator", "text": "Последняя запись — за день до смерти.", "gap": 0.32,
        "parts": [["Последняя запись — за день до смерти.", -6, -4]] },
      { "id": "j3", "who": "narrator", "text": "Три двенадцать. Опять пришли. Свет не выключать.", "gap": 0.38,
        "parts": [["Три двенадцать.", -12, -5, 0.42], ["Опять пришли.", -12, -5, 0.45], ["Свет не выключать.", -14, -6]] },
      { "id": "j4", "who": "narrator", "text": "Следующая страница вырвана.", "gap": 0.0,
        "parts": [["Следующая страница вырвана.", -6, -3]] }
    ]},
    { "id": "chapter", "pre": 0.35, "post": 0.45, "lines": [
      { "id": "k1", "who": "narrator", "text": "Ночь первая.", "gap": 0.0,
        "parts": [["Ночь первая.", -12, -6]] }
    ]},
    { "id": "sleep", "pre": 0.35, "post": 0.4, "lines": [
      { "id": "m1", "who": "narrator", "text": "Ты засыпаешь на дедовом диване.", "gap": 0.45,
        "parts": [["Ты засыпаешь на дедовом диване.", -8, -4]] },
      { "id": "m2", "who": "narrator", "text": "Три одиннадцать.", "gap": 0.5,
        "parts": [["Три одиннадцать.", -12, -5]] },
      { "id": "m3", "who": "narrator", "text": "Три двенадцать.", "gap": 0.6,
        "parts": [["Три двенадцать.", -14, -6]] },
      { "id": "m4", "who": "narrator", "text": "Щелчок. И по стене ползёт свет.", "gap": 0.0,
        "parts": [["Щелчок.", -4, 2, 0.5], ["И по стене ползёт свет.", -10, -3]] }
    ]},
    { "id": "night", "pre": 0.4, "post": 0.5, "lines": [
      { "id": "x1", "who": "narrator", "text": "Ты выбегаешь на улицу. Маяк горит.", "gap": 0.3,
        "parts": [["Ты выбегаешь на улицу.", 8, 3, 0.32], ["Маяк горит.", -10, -2]] },
      { "id": "x3", "who": "narrator", "text": "А потом с моря отвечают. Три вспышки. Пауза. Ещё три.", "gap": 0.45,
        "parts": [["А потом с моря отвечают.", -6, -3, 0.4], ["Три вспышки.", -8, 0, 0.4], ["Пауза.", -10, -3, 0.5], ["Ещё три.", -8, 0]] },
      { "id": "x4", "who": "narrator", "text": "И дверь в башню. Вечером ты закрыл её на ключ. Сейчас она открыта.", "gap": 0.0,
        "parts": [["И дверь в башню.", -8, -3, 0.42], ["Вечером ты закрыл её на ключ.", -2, 0, 0.42], ["Сейчас она открыта.", -14, -6]] }
    ]},
    { "id": "choice", "pre": 0.35, "post": 0.4, "lines": [
      { "id": "q1", "who": "narrator", "text": "Твой ход.", "gap": 0.28,
        "parts": [["Твой ход.", -4, 3]] },
      { "id": "q2", "who": "narrator", "text": "А — подняться в башню.", "gap": 0.22,
        "parts": [["Вариант «А».", 0, 3, 0.25], ["Подняться в башню.", 2, 0]] },
      { "id": "q3", "who": "narrator", "text": "Б — спуститься к воде.", "gap": 0.22,
        "parts": [["Вариант «Бэ».", 0, 3, 0.25], ["Спуститься к воде.", 2, 0]] },
      { "id": "q4", "who": "narrator", "text": "В — запереться, а утром взять деньги и уехать.", "gap": 0.3,
        "parts": [["Вариант «Вэ».", 0, 3, 0.25], ["Запереться, а утром взять деньги и уехать.", 2, -1]] },
      { "id": "q5", "who": "narrator", "text": "Пиши букву в комментариях. Какая победит — так и сделаем.", "gap": 0.25,
        "parts": [["Пиши букву в комментариях.", 4, 3, 0.3], ["Какая победит — так и сделаем.", 2, 1]] },
      { "id": "q6", "who": "narrator", "text": "А если есть идея, как маяку заработать, — пиши тоже. Лучшую возьму в следующую серию.", "gap": 0.0,
        "parts": [["А если есть идея, как маяку заработать, — пиши тоже.", 3, 2, 0.3], ["Лучшую возьму в следующую серию.", 2, 1]] }
    ]},
    { "id": "end", "dur": 2.8, "lines": [] }
  ]
